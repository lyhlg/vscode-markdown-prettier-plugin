{
    "name": "markdown-prettier",
    "displayName": "Markdown Prettier",
    "description": "A beautiful markdown viewer with colored headings and TOC sidebar",
    "publisher": "lyhlg",
    "version": "0.0.5",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "markdownViewer.open",
                "title": "Markdown Prettier: Open Preview",
                "icon": {
                    "light": "icons/md-preview-light.svg",
                    "dark": "icons/md-preview-dark.svg"
                }
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "markdownViewer.open",
                    "when": "editorLangId == markdown",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "markdownViewer.open",
                "key": "ctrl+shift+m",
                "mac": "cmd+shift+m",
                "when": "editorLangId == markdown"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package --allow-missing-repository",
        "update-and-publish": "npm run compile && npm run package && VERSION=$(node -p \"require('./package.json').version\") && git add -A && git commit -m \"release: v$VERSION\" && git push origin main && gh release create v$VERSION markdown-prettier-$VERSION.vsix --title \"v$VERSION\" --generate-notes"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/markdown-it": "^14.1.1",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "markdown-it": "^14.1.0"
    },
    "license": "MIT"
}